{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Run Binday CLI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal",
            "args": [
                "--ssh", "root@127.0.0.1",
                "--ssh-password", "YOURSERVERPASSWORD",
                "--pg-dsn", "host=127.0.0.1 dbname=mattermost user=mmuser password=YOURDBPASSWORD",
                "--remote-data-dir", "/mnt/user/mattermost/data",
                "--mm-server", "http://127.0.0.1:8065",
                "--purge-archived-channels",
                "--purge-deactivated-users",
                "--purge-db-orphans",
                "--vacuum"
            ]
        }
    ]
}